// Shared view/frame ABI for material raster, deferred shading, and composition.
<Frame> view: mat4x4f;
<Frame> proj: mat4x4f;
<Frame> camera_position: vec4f;
// clip: near, far, screen noise-cell width in pixels, reserved.
<Frame> clip: vec4f;
// Legacy direct-material fade: start degrees, end degrees, enabled, reserved.
<Frame> grazing: vec4f;
#for name, type_name in PARAMS.get("frame_fields", {}).items()
{{ field("Frame", name, type_name) }}
#endfor
uniform<0, 0> frame: Frame;

// Scene lighting changes independently of camera motion and application frame fields.
<Lighting> light_dir: vec4f;
uniform<0, 1> lighting: Lighting;
